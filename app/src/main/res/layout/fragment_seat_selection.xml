<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp"
    tools:context=".ui.seat_selection.SeatSelectionFragment">

    <!-- Stepper layout -->
    <LinearLayout
        android:id="@+id/layoutStepper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <!-- Step 1: Location & Date (Completed) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_weight="1">
            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_stepper_completed"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ngày"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
        
        <View
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="0.4"
            android:background="@color/neon_pink"
            android:layout_gravity="center_vertical"
            android:layout_marginBottom="12dp" />

        <!-- Step 2: Seat Selection (Active) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_weight="1">
            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_stepper_active"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chọn ghế"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="0.4"
            android:background="@color/glass_border"
            android:layout_gravity="center_vertical"
            android:layout_marginBottom="12dp" />

        <!-- Step 3: Overview (Inactive) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_weight="1">
            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_stepper_inactive"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tổng quan"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="0.4"
            android:background="@color/glass_border"
            android:layout_gravity="center_vertical"
            android:layout_marginBottom="12dp" />

        <!-- Step 4: Payment (Inactive) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_weight="1">
            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_stepper_inactive"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thanh toán"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="0.4"
            android:background="@color/glass_border"
            android:layout_gravity="center_vertical"
            android:layout_marginBottom="12dp" />

        <!-- Step 5: Download (Inactive) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_weight="1">
            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_stepper_inactive"
                android:gravity="center"
                android:text="5"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tải vé"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Concert Header -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardConcertHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/bg_card"
        app:strokeColor="@color/glass_border"
        app:strokeWidth="1.2dp"
        app:layout_constraintTop_toBottomOf="@id/layoutStepper"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <!-- Date Card (Left) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDateBadge"
                android:layout_width="60dp"
                android:layout_height="80dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#1A1AFF"
                app:strokeColor="@color/neon_cyan"
                app:strokeWidth="1dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/textDateDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textDateMonthYear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tháng 6\n2026"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textAlignment="center"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Concert Details (Right) -->
            <TextView
                android:id="@+id/textConcertTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Đang tải sự kiện..."
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/cardDateBadge"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/textTimer" />

            <TextView
                android:id="@+id/textAvailableStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:text="● Đang kiểm tra"
                android:textColor="#00FF7F"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@id/cardDateBadge"
                app:layout_constraintTop_toBottomOf="@id/textConcertTitle" />

            <TextView
                android:id="@+id/textConcertPriceRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:text="Giá: --"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@id/cardDateBadge"
                app:layout_constraintTop_toBottomOf="@id/textAvailableStatus" />

            <!-- Time Left / Timer -->
            <TextView
                android:id="@+id/textTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giữ chỗ: 09:59"
                android:textColor="@color/neon_pink"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnChangeDate"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="Đổi Ngày"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_outline_button"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Price Range Selector -->
    <LinearLayout
        android:id="@+id/layoutPriceFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/cardConcertHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Lọc theo khoảng giá vé:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/textSliderRangeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tất cả các giá"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.slider.RangeSlider
            android:id="@+id/sliderPriceFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.0"
            android:valueTo="3000000.0"
            app:thumbColor="@color/neon_purple"
            app:thumbStrokeColor="@color/white"
            app:thumbStrokeWidth="1dp"
            app:trackColorActive="@color/neon_pink"
            app:trackColorInactive="@color/glass_border" />
    </LinearLayout>

    <!-- Seating Layout Frame -->
    <FrameLayout
        android:id="@+id/layoutContainerFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/layoutPriceFilter"
        app:layout_constraintBottom_toTopOf="@id/layoutSelectedSeatsFooter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Stage 1: Arena Overview Map -->
        <ScrollView
            android:id="@+id/layoutArenaOverview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="8dp">

                <!-- Stage visualizer -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="180dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="22dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:strokeColor="@color/neon_pink"
                    app:strokeWidth="1.8dp"
                    android:layout_marginBottom="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="🎤 STAGE / SÂN KHẤU CHÍNH"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Guideline -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHẠM CHỌN KHU VỰC VÉ TRÊN KHÁN ĐÀI"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    android:layout_marginBottom="14dp" />

                <!-- Container grid of Zones (Arena map circular layout simulated gracefully as grid) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerArenaZones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </ScrollView>

        <!-- Stage 2: Detailed Seat Grid inside Zone -->
        <LinearLayout
            android:id="@+id/layoutDetailedGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Title & Back -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/textSelectedZoneTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Khu vực: VIP"
                    android:textColor="@color/neon_cyan"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnChangeSection"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="← Đổi Phân Khu"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/bg_outline_button" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/glass_border"
                android:layout_marginBottom="10dp" />

            <!-- Seating scroll grid -->
            <ScrollView
                android:id="@+id/scrollDetailedSeats"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/containerSeats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp" />
                </HorizontalScrollView>
            </ScrollView>

            <!-- Legends inside grid selection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:paddingVertical="4dp">
                
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_stepper_active"
                    android:layout_marginEnd="4dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trống"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:layout_marginEnd="12dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_rounded_card"
                    android:backgroundTint="@color/neon_cyan"
                    android:layout_marginEnd="4dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đang chọn"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:layout_marginEnd="12dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_rounded_card"
                    android:backgroundTint="#FF8C00"
                    android:layout_marginEnd="4dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giữ chỗ"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:layout_marginEnd="12dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_rounded_card"
                    android:backgroundTint="#2E2E38"
                    android:layout_marginEnd="4dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đã bán"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Loading Indicators -->
    <ProgressBar
        android:id="@+id/progressSeats"
        style="?android:attr/progressBarStyle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        android:indeterminateTint="@color/neon_purple"
        app:layout_constraintTop_toBottomOf="@id/layoutPriceFilter"
        app:layout_constraintBottom_toTopOf="@id/layoutSelectedSeatsFooter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/neon_pink"
        android:textSize="13sp"
        android:visibility="gone"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/layoutPriceFilter"
        app:layout_constraintBottom_toTopOf="@id/layoutSelectedSeatsFooter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Selected Seats list above footer bill -->
    <LinearLayout
        android:id="@+id/layoutSelectedSeatsFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/panelPrice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/textSelectedSeatsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ghế đang chọn:"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/scrollSelectedChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/containerSelectedChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="4dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Glassmorphic Bill Summary Panel -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panelPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/bg_card"
        app:strokeColor="@color/glass_border"
        app:strokeWidth="1.2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Chosen seats count row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Số lượng ghế:"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textSelectedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 ghế"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Dynamic price subtotal row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Tổng tiền:"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textTotalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 đ"
                    android:textColor="@color/neon_pink"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Action Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="TIẾP TỤC ĐẶT VÉ"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp"
                android:background="@drawable/bg_neon_pink_button"
                android:elevation="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
