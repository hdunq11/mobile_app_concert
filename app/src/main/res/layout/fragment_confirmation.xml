<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="24dp"
    tools:context=".ui.confirmation.ConfirmationFragment">

    <!-- Glowing success icon wrapper -->
    <ImageView
        android:id="@+id/iconSuccess"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@android:drawable/checkbox_on_background"
        android:contentDescription="Success"
        app:tint="@color/neon_cyan"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/textSuccess"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Thanh toán thành công! 🎉"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:textAlignment="center"
        android:fontFamily="sans-serif-black"
        app:layout_constraintTop_toBottomOf="@id/iconSuccess"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tear-off Artistic Ticket Card Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ticket_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/textSuccess">

        <!-- Outer Ticket Slate Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_ticket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/bg_card"
            app:strokeColor="@color/glass_border"
            app:strokeWidth="1.2dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VÉ ĐIỆN TỬ / DIGITAL TICKET"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="12dp" />

                <!-- Ticket Code -->
                <TextView
                    android:id="@+id/textOrderId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mã vé: LOADING..."
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trạng thái: ĐÃ THANH TOÁN"
                    android:textColor="@color/neon_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <!-- Tear-off Dashed Line across the ticket -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/glass_border"
                    android:alpha="0.6"
                    android:layout_marginBottom="20dp" />

                <!-- QR Code scanning box -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/white"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="2dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp">

                        <!-- Realistic Mock QR Code blocks -->
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@android:drawable/ic_dialog_dialer"
                            app:tint="@color/black"
                            android:scaleType="fitCenter" />

                        <!-- Tiny center icon -->
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/btn_star_big_on"
                            app:tint="@color/neon_pink" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Gate verification instructions -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="*Vui lòng xuất trình mã này tại quầy soát vé vào cổng"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Semicircular Notches - XML Negative bite trick (Left side) -->
        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_rounded_card"
            android:backgroundTint="@color/bg_dark"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="-12dp" />

        <!-- Semicircular Notches - XML Negative bite trick (Right side) -->
        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_rounded_card"
            android:backgroundTint="@color/bg_dark"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="-12dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Buttons -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnViewTickets"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="XEM VÉ CỦA TÔI 🎫"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/bg_neon_button"
        app:layout_constraintBottom_toTopOf="@id/btnBackHome"
        android:layout_marginBottom="12dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBackHome"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="QUAY LẠI TRANG CHỦ"
        android:textColor="@color/neon_pink"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/bg_outline_button"
        android:backgroundTint="#00000000"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
