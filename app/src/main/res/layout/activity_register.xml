<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="24dp">

    <!-- Decorative Top Glowing Aura (Neon Pink) -->
    <View
        android:id="@+id/top_glow"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@android:drawable/dialog_holo_dark_frame"
        android:backgroundTint="#15FF1493"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="-130dp"
        android:layout_marginStart="-130dp" />

    <!-- Decorative Right Middle Glowing Aura (Neon Purple) -->
    <View
        android:id="@+id/right_glow"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@android:drawable/dialog_holo_dark_frame"
        android:backgroundTint="#128E2DE2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="-110dp" />

    <!-- App Brand Logo Section -->
    <LinearLayout
        android:id="@+id/logo_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp">

        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ĐĂNG KÝ"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/title_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Khám Phá Hàng Triệu Show Diễn Hot 🔥"
            android:textColor="@color/neon_cyan"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.02" />
    </LinearLayout>

    <!-- Glassmorphic Register Form Scrollable Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/form_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/bg_card"
        app:strokeColor="@color/glass_border"
        app:strokeWidth="1.2dp"
        app:layout_constraintTop_toBottomOf="@id/logo_section"
        app:layout_constraintBottom_toTopOf="@id/btn_register"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbarThumbVertical="@null">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Full Name Input Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_name_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:textColorHint="@color/text_muted"
                    app:hintTextColor="@color/neon_purple"
                    app:boxStrokeColor="@color/neon_purple"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Họ và Tên"
                        android:textColor="@color/white"
                        android:inputType="textPersonName"
                        android:textSize="14sp"
                        android:paddingHorizontal="16dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email Input Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_email_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:textColorHint="@color/text_muted"
                    app:hintTextColor="@color/neon_purple"
                    app:boxStrokeColor="@color/neon_purple"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Email"
                        android:textColor="@color/white"
                        android:inputType="textEmailAddress"
                        android:textSize="14sp"
                        android:paddingHorizontal="16dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password Input Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_password_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:textColorHint="@color/text_muted"
                    app:hintTextColor="@color/neon_purple"
                    app:boxStrokeColor="@color/neon_purple"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/text_muted"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Mật khẩu"
                        android:textColor="@color/white"
                        android:inputType="textPassword"
                        android:textSize="14sp"
                        android:paddingHorizontal="16dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Confirm Password Input Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_confirm_password_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="@color/text_muted"
                    app:hintTextColor="@color/neon_purple"
                    app:boxStrokeColor="@color/neon_purple"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/text_muted"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_password_confirm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Xác nhận mật khẩu"
                        android:textColor="@color/white"
                        android:inputType="textPassword"
                        android:textSize="14sp"
                        android:paddingHorizontal="16dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <ProgressBar
                    android:id="@+id/progress_register"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    android:indeterminateTint="@color/neon_purple" />

                <TextView
                    android:id="@+id/text_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/neon_pink"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:textAlignment="center"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Premium Action Button (Neon Pink-Purple Styled) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_register"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="ĐĂNG KÝ NGAY"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/bg_neon_button"
        app:layout_constraintBottom_toTopOf="@id/btn_go_login"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/btn_go_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đã có tài khoản? Đăng nhập ngay"
        android:textColor="@color/neon_cyan"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
